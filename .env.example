# Public Supabase keys (safe for browser bundle)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Server-only Supabase secret key (used for Stripe webhooks, rewards, and Admin writes)
SUPABASE_SECRET_KEY=

# Comma-separated allowlist of Admin email addresses allowed into /admin write APIs
ADMIN_EMAILS=

# Stripe (used by /api/checkout, /api/webhooks/stripe, and /api/rewards/claim)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_AUTOMATIC_TAX=false
FLAT_RATE_SHIPPING_CENTS=995
FREE_SHIPPING_THRESHOLD_CENTS=12500

# Public canonical URL for Checkout success/cancel redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional POD integration (Printful)
PRINTFUL_API_TOKEN=
